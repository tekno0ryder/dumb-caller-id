<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back" />

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- Bot -->
        <TextView
            style="@style/Text.Section"
            android:paddingTop="16dp"
            android:text="@string/section_bot" />

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="@string/bot_label" />

            <!-- Fixed "@" so it's clear only the name is typed. Always LTR, like the username itself.
                 addStatesFromChildren gives the frame the field's focused outline. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:addStatesFromChildren="true"
                android:background="@drawable/input_bg"
                android:gravity="center_vertical"
                android:layoutDirection="ltr"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/at_sign"
                    android:textColor="@color/text_secondary" />

                <EditText
                    android:id="@+id/botInput"
                    style="@style/Text.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/bot_hint"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:minHeight="48dp"
                    android:paddingHorizontal="2dp"
                    android:singleLine="true"
                    android:textColorHint="@color/text_secondary"
                    android:textDirection="ltr" />
            </LinearLayout>

            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="@string/bot_privacy" />

            <Button
                android:id="@+id/saveButton"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/save" />

            <TextView
                android:id="@+id/botStatus"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Popup test -->
        <TextView
            style="@style/Text.Section"
            android:text="@string/section_popup" />

        <LinearLayout style="@style/Card">

            <Button
                android:id="@+id/testButton"
                style="@style/Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/test_popup" />

            <TextView
                android:id="@+id/testStatus"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Setup -->
        <TextView
            style="@style/Text.Section"
            android:text="@string/setup" />

        <LinearLayout
            android:id="@+id/checklist"
            style="@style/Card"
            android:divider="@drawable/divider"
            android:paddingVertical="4dp"
            android:showDividers="middle" />

        <!-- Help: a report the user can send to whoever helps them -->
        <TextView
            style="@style/Text.Section"
            android:text="@string/section_help" />

        <LinearLayout style="@style/Card">

            <Button
                android:id="@+id/copyDiagnostics"
                style="@style/Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/copy_diagnostics" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:text="@string/diagnostics_summary" />
        </LinearLayout>

        <!-- About: version with an update check, and where the code lives -->
        <TextView
            style="@style/Text.Section"
            android:text="@string/section_about" />

        <LinearLayout
            style="@style/Card"
            android:divider="@drawable/divider"
            android:paddingVertical="4dp"
            android:showDividers="middle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingVertical="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/version_label" />

                    <TextView
                        android:id="@+id/version"
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="2dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/checkUpdates"
                    style="@style/Button.Tonal.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/check_updates" />
            </LinearLayout>

            <!-- The whole row opens the repository -->
            <LinearLayout
                android:id="@+id/sourceCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:minHeight="64dp"
                android:orientation="vertical"
                android:paddingVertical="10dp">

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/source_code_label" />

                <!-- A web address reads and aligns left-to-right, also in Arabic -->
                <TextView
                    android:id="@+id/sourceCodeUrl"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:textAlignment="textStart"
                    android:textColor="@color/brand_text"
                    android:textDirection="ltr"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
